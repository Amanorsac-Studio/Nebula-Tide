<?xml version="1.0" encoding="UTF-8"?>
<!--
    Extra Info.plist keys merged into the iOS/iPadOS build.

    ITSAppUsesNonExemptEncryption = false:
    Nebula Tide encrypts only its own bundled sound library, purely to protect
    the developer's audio content. Encryption used solely for copy/content
    protection is exempt from US export regulations, so App Store Connect does
    not need an export-compliance review for each submission.
-->
<plist version="1.0">
  <dict>
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
    <key>UIRequiresPersistentWiFi</key>
    <false/>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.music</string>
  </dict>
</plist>
